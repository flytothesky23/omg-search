{
	"name": "master-of-knowledge-agy",
	"version": "2.0.40",
	"description": "Antigravity CLI OAuth 에이전트 작업을 사용하는 Obsidian 지식 작업공간",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"antigravity",
		"oauth",
		"ai",
		"rag"
	],
	"author": "김문정",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^16.11.6",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.25.12",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "4.7.4"
	}
}
